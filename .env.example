# Create an application at https://discord.com/developers/applications
# Enable: Server Members Intent, Message Content Intent, Direct Messages

DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_application_client_id_here
GUILD_ID=your_server_id_here
PORT=3002

# Voice mod — local by default (no OpenAI required)
# STT: local Whisper (transformers.js) or openai
VOICE_STT=local
WHISPER_MODEL=Xenova/whisper-tiny.en

# Ollama judges transcripts for slurs (must be running)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
VOICE_MOD_PROVIDER=ollama

# Optional cloud STT instead of local:
# VOICE_STT=openai
# OPENAI_API_KEY=
